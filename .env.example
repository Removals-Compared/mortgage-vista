# Mortgage Vista Limited — Environment variables
# Copy this file to .env.local and fill in the values before going live.

# ---- Site ----
# Used by sitemap.xml, robots.txt, OG tags, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.mortgagevista.co.uk

# ---- Database (Neon Postgres) ----
# Pooled connection string from the Neon console (Connect). Apply db/schema.sql
# once to a fresh database. Stores enquiries, newsletter sign-ups and calculator
# leads. Optional: without it, enquiries are email-only.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# ---- Email delivery (SMTP, e.g. a Gmail app password) ----
# MAIL_TO gets each contact enquiry. Calculator results are emailed to the visitor.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mortgage Vista <you@gmail.com>
MAIL_TO=advisers@mortgagevista.co.uk

# ---- Optional: Analytics ----
# GA4 measurement ID — only loads if cookie consent is granted.
NEXT_PUBLIC_GA_ID=
# Plausible domain (alternative to GA4)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
