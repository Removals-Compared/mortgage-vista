# Mortgage Vista Limited — Environment variables
# Copy this file to .env.local and fill in the values before going live.

# ---- Site ----
# Used by sitemap.xml, robots.txt, OG tags, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.mortgagevista.co.uk

# ---- Email delivery (transactional — contact forms, calculator results) ----
# Recommended: Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=enquiries@mortgagevista.co.uk
MAIL_TO=advisers@mortgagevista.co.uk

# ---- Newsletter ESP (pick ONE set) ----
# Mailchimp:
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER=

# ConvertKit:
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# Resend Audiences:
RESEND_AUDIENCE_ID=

# ---- Optional: Analytics ----
# GA4 measurement ID — only loads if cookie consent is granted.
NEXT_PUBLIC_GA_ID=
# Plausible domain (alternative to GA4)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
